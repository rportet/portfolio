@page "/"

<PageTitle>Rémy Portet</PageTitle>

<h1>Rémy Portet</h1>

<p class="lead">Développeur .NET junior. Accroche de test pour vérifier le style .lead sur deux lignes environ.</p>

<section class="mt-5">
    <h2>Titre de section</h2>

    <h3>Titre de card</h3>
    <p>Paragraphe de texte courant en Figtree, pour vérifier la taille, l'interligne et la couleur du corps de texte dans les deux thèmes.</p>

    <ul class="list-unstyled d-flex flex-wrap gap-1" aria-label="Technologies">
        <li class="rp-tag">Blazor</li>
    </ul>

    <button type="button" class="btn btn-primary">Bouton principal</button>
</section>

@if (profile is not null)
{
    <section class="mt-5">
        <h2>Profile</h2>
        <ul>
            <li>FirstName: @profile.FirstName</li>
            <li>LastName: @profile.LastName</li>
            <li>Badge: @profile.Badge.Value</li>
            <li>Lead: @profile.Lead.Value</li>
            <li>
                Stack:
                <ul>
                    @foreach (var group in profile.Stack)
                    {
                        <li>Label: @group.Label.Value, Items: @string.Join(", ", group.Items)</li>
                    }
                </ul>
            </li>
            <li>GitHub: @profile.Links.GitHub</li>
            <li>LinkedIn: @profile.Links.LinkedIn</li>
            <li>Email: @profile.Links.Email</li>
            <li>Cv: @profile.Links.Cv</li>
        </ul>
    </section>

    <section class="mt-5">
        <h2>Education</h2>
        @foreach (var step in education)
        {
            <ul>
                <li>Start: @step.Start</li>
                <li>End: @step.End</li>
                <li>Title: @step.Title.Value</li>
                <li>Subtitle: @step.Subtitle.Value</li>
                <li>Compact: @step.Compact</li>
            </ul>
        }
    </section>

    <section class="mt-5">
        <h2>Experiences</h2>
        @foreach (var experience in experiences)
        {
            <ul>
                <li>Type: @experience.Type</li>
                <li>Badge: @experience.Badge.Value</li>
                <li>Start: @experience.Start</li>
                <li>End: @experience.End</li>
                <li>Title: @experience.Title.Value</li>
                <li>Company: @experience.Company</li>
                <li>Description: @experience.Description.Value</li>
                <li>Tags: @string.Join(", ", experience.Tags)</li>
            </ul>
        }
    </section>

    <section class="mt-5">
        <h2>Projects</h2>
        @foreach (var project in projects)
        {
            <ul>
                <li>Slug: @project.Slug</li>
                <li>Title: @project.Title.Value</li>
                <li>Tagline: @project.Tagline.Value</li>
                <li>Tags: @string.Join(", ", project.Tags)</li>
                <li>Image: @(project.Image ?? "null")</li>
                <li>RepositoryUrl: @(project.RepositoryUrl ?? "null")</li>
                <li>DemoUrl: @(project.DemoUrl ?? "null")</li>
            </ul>
        }
    </section>
}
