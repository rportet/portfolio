@if (profile is not null)
{
    <div class="rp-contact d-flex flex-column flex-lg-row justify-content-lg-between align-items-lg-end">
        <div>
            <h2 class="rp-overline rp-contact-title">@Loc["ContactBlock_Title"]</h2>
            <a class="rp-contact-email" href="@EmailHref">@emailLocalPart<span class="rp-contact-email-domain">@emailDomain</span></a>
        </div>

        <div class="rp-contact-actions d-flex flex-wrap">
            <ActionLink Href="@profile.Links.GitHub" Text="@Loc["Hero_GitHub"]" Icon="IconName.ArrowUpRight" Behavior="LinkBehavior.NewTab" Variant="ActionLinkVariant.ContrastOutline" />
            <ActionLink Href="@profile.Links.LinkedIn" Text="@Loc["Hero_LinkedIn"]" Icon="IconName.ArrowUpRight" Behavior="LinkBehavior.NewTab" Variant="ActionLinkVariant.ContrastOutline" />
            <ActionLink Href="@profile.Links.Cv" Text="@Loc["Hero_Cv"]" Icon="IconName.ArrowDown" Behavior="LinkBehavior.Download" Variant="ActionLinkVariant.Accent" />
        </div>
    </div>
}
