<div class="rp-language-group d-none d-lg-inline-flex" role="group" aria-label="@Loc["LanguageSelector_GroupLabel"]">
    @foreach (var language in Languages)
    {
        <button type="button" class="rp-language-pill" lang="@language.Culture" aria-label="@Loc[language.NameKey]" aria-pressed="@AriaPressed(language)" @onclick="() => SwitchToAsync(language.Culture)">
            @Loc[language.CodeKey]
        </button>
    }
</div>

<button type="button" class="rp-icon-button rounded-circle d-lg-none" lang="@TargetCulture" aria-label="@Loc["LanguageSelector_Switch"]" @onclick="() => SwitchToAsync(TargetCulture)">
    @Loc[CurrentCodeKey]
</button>
